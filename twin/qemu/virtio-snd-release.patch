+     * guest refuses its next prepare ("invalid I/O queue state").
+     */
+    if (stream->info.direction == VIRTIO_SND_D_OUTPUT) {
+        virtio_snd_handle_tx_xfer(VIRTIO_DEVICE(s), s->queues[VIRTIO_SND_VQ_TX]);
